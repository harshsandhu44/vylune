# =============================================================================
# VYLUNE ENVIRONMENT VARIABLES REFERENCE
# =============================================================================
# This file documents all environment variables used across the monorepo.
# Copy relevant sections to .env.local files in each workspace.

# =============================================================================
# FRONTEND (apps/web/.env.local)
# =============================================================================

# API Configuration
NEXT_PUBLIC_API_URL=https://your-api.execute-api.eu-central-1.amazonaws.com
# Local: http://localhost:3001

# AWS Cognito Configuration
NEXT_PUBLIC_AWS_REGION=eu-central-1
NEXT_PUBLIC_COGNITO_USER_POOL_ID=eu-central-1_XXXXXXXXX
NEXT_PUBLIC_COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

# Application URL (for redirects)
NEXT_PUBLIC_APP_URL=https://vylune.com
# Local: http://localhost:3000


# =============================================================================
# BACKEND API (services/api/.env.local)
# =============================================================================

# Polar.sh Payment Integration
# Get these from: https://polar.sh/dashboard/settings
POLAR_API_KEY=polar_XXXXXXXXXXXXXXXXXXXXXXXXXX
POLAR_BASE_PRODUCT_ID=prod_XXXXXXXXXXXXXXXXXX        # Base plan (€25, 5 seats)
POLAR_ADDITIONAL_SEAT_PRICE_ID=price_XXXXXXXXXXXXXXXXXX  # Additional seats (€10 each)
POLAR_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXX
POLAR_API_URL=https://api.polar.sh

# Frontend URL (for payment success redirects)
FRONTEND_URL=https://vylune.com
# Local: http://localhost:3000

# AWS DynamoDB
TABLE_NAME=VyluneTable-Prd
# Dev: VyluneTable-Dev

# AWS Region
AWS_REGION=eu-central-1


# =============================================================================
# CDK DEPLOYMENT (infra/cdk)
# =============================================================================
# Export these before running 'bun run cdk:deploy'

# For Dev Environment
# export AWS_PROFILE=your-aws-profile
# export AWS_REGION=eu-central-1
# export CDK_ENV=dev
# export POLAR_API_KEY=polar_xxx
# export POLAR_BASE_PRODUCT_ID=prod_xxx
# export POLAR_ADDITIONAL_SEAT_PRICE_ID=price_xxx
# export POLAR_WEBHOOK_SECRET=whsec_xxx
# export FRONTEND_URL=https://stg.vylune.com

# For Production Environment
# export AWS_PROFILE=your-aws-profile
# export AWS_REGION=eu-central-1
# export CDK_ENV=prd
# export POLAR_API_KEY=polar_xxx
# export POLAR_BASE_PRODUCT_ID=prod_xxx
# export POLAR_ADDITIONAL_SEAT_PRICE_ID=price_xxx
# export POLAR_WEBHOOK_SECRET=whsec_xxx
# export FRONTEND_URL=https://vylune.com


# =============================================================================
# POLAR.SH SETUP CHECKLIST
# =============================================================================
# 1. Create account at https://polar.sh
# 2. Create "Base Plan" product (€25/month, 5 seats)
# 3. Create "Additional Seat" price (€10/month per seat)
# 4. Get API key from Settings → API Keys
# 5. Configure webhook at Settings → Webhooks:
#    - URL: https://your-api.amazonaws.com/webhooks/polar
#    - Events: checkout.created, subscription.created, subscription.updated, subscription.cancelled
# 6. Copy Product IDs, Price IDs, API Key, and Webhook Secret to .env files
# 7. Test in Test Mode before going live


# =============================================================================
# NOTES
# =============================================================================
# - Never commit .env.local files to git (already in .gitignore)
# - Use different Polar.sh products for dev/staging/prod environments
# - Webhook URL must be publicly accessible (use ngrok for local testing)
# - Frontend variables prefixed with NEXT_PUBLIC_ are exposed to browser
