{
  "name": "@vylune/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/utils/lambda.ts --outdir dist --target node --minify --format cjs",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@vylune/core": "workspace:*",
    "@trpc/server": "^11.0.0",
    "@aws-sdk/client-dynamodb": "^3.705.0",
    "@aws-sdk/lib-dynamodb": "^3.705.0",
    "@aws-sdk/client-sesv2": "^3.705.0",
    "dynamodb-onetable": "^2.7.5",
    "aws-lambda": "^1.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/bun": "^1.3.4",
    "typescript": "^5.6.0"
  }
}
