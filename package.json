{
  "name": "vylune",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*",
    "infra/*"
  ],
  "scripts": {
    "dev": "bun run --filter './apps/*' dev",
    "dev:web": "bun run --filter '@vylune/web' dev",
    "dev:api": "bun run --filter '@vylune/api' dev",
    "build": "bun run build:packages && bun run build:apps && bun run build:services",
    "build:packages": "bun run --filter './packages/*' build",
    "build:apps": "bun run --filter './apps/*' build",
    "build:services": "bun run --filter './services/*' build",
    "build:infra": "bun run --filter '@vylune/infra-cdk' build",
    "type-check": "bun run --filter './packages/*' type-check && bun run --filter './apps/*' type-check && bun run --filter './services/*' type-check",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "clean": "bun run --filter './apps/*' clean && bun run --filter './packages/*' clean && bun run --filter './services/*' clean",
    "cdk:synth": "bun run --filter '@vylune/infra-cdk' synth",
    "cdk:synth:dev": "bun run --filter '@vylune/infra-cdk' synth:dev",
    "cdk:synth:stg": "bun run --filter '@vylune/infra-cdk' synth:stg",
    "cdk:synth:prd": "bun run --filter '@vylune/infra-cdk' synth:prd",
    "cdk:deploy": "bun run --filter '@vylune/infra-cdk' deploy",
    "cdk:deploy:dev": "bun run --filter '@vylune/infra-cdk' deploy:dev",
    "cdk:deploy:stg": "bun run --filter '@vylune/infra-cdk' deploy:stg",
    "cdk:deploy:prd": "bun run --filter '@vylune/infra-cdk' deploy:prd",
    "cdk:diff": "bun run --filter '@vylune/infra-cdk' diff",
    "cdk:diff:dev": "bun run --filter '@vylune/infra-cdk' diff:dev",
    "cdk:diff:stg": "bun run --filter '@vylune/infra-cdk' diff:stg",
    "cdk:diff:prd": "bun run --filter '@vylune/infra-cdk' diff:prd"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.5",
    "typescript": "^5.6.0"
  }
}
